---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/LeadForm';
import Gallery from '@/components/Gallery';
import Testimonials from '@/components/Testimonials.astro';
import FAQSchema from '@/components/FAQSchema.astro';
import { SERVICES, FAQS, PHONE_NUMBER, NEIGHBORHOODS } from '@/lib/constants';

const title = 'Seattle Concrete Contractors | Flatwork, Driveways & Patios | Cloud Concrete';
const description = "Seattle's top-rated concrete contractors — expert flatwork for driveways, patios, stamped concrete & foundations. Licensed & insured, 10-year warranty, 57+ five-star reviews. Get a free estimate today.";
---

<BaseLayout title={title} description={description}>
  <FAQSchema faqs={FAQS} />

  <div class="space-y-0">
    <!-- Hero Section -->
    <section class="relative bg-brand-dark overflow-hidden pt-12 pb-16 md:pt-20 md:pb-20">
      <div class="absolute inset-0">
        <img
          src="/images/concrete-40.jpeg"
          alt="Concrete background"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-brand-dark/80"></div>
      </div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
          <div class="lg:w-1/2 text-white">
            <p class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-white px-4 py-2 rounded-full text-sm font-black mb-6">
              <span class="flex text-brand-secondary" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-4 h-4 fill-current opacity-40" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              </span>
              <span>4.9 · 57 reviews</span>
            </p>
            <h1 class="text-5xl md:text-7xl font-black mb-8 leading-[1.1]">
              Seattle Concrete Flatwork <br/><span class="text-brand-secondary italic">& Driveway Contractors</span>
            </h1>
            <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-xl leading-relaxed font-medium">
              Expert concrete flatwork: driveways, patios, foundations, <a href="/services/concrete-repair" class="underline decoration-brand-secondary/50 hover:decoration-brand-secondary transition-colors">concrete repair</a>, and <a href="/services/stamped-concrete" class="underline decoration-brand-secondary/50 hover:decoration-brand-secondary transition-colors">stamped concrete</a> built to last. Seattle's trusted concrete company with 10-year warranty and free estimates.
            </p>
            <figure class="max-w-xl bg-white/10 border border-white/15 rounded-2xl p-5">
              <div class="flex text-brand-secondary mb-3" aria-label="5 stars">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-base md:text-lg text-white font-medium leading-relaxed italic">
                &quot;Cloud Concrete did an amazing job on our stamped concrete patio. The team was professional, clean, and finished ahead of schedule. Highly recommend!&quot;
              </blockquote>
              <figcaption class="mt-3 text-xs font-black uppercase tracking-widest text-brand-secondary">Sarah Jenkins, Ballard</figcaption>
            </figure>
          </div>
          <div id="form" class="lg:w-1/2 w-full max-w-xl flex flex-col gap-4">
            <a href={`tel:${PHONE_NUMBER}`} class="w-full bg-brand-primary hover:brightness-110 text-white px-10 py-5 rounded-xl text-lg font-black shadow-2xl transition-all flex items-center justify-center gap-3">
              <svg class="w-6 h-6 text-brand-secondary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 005.455 5.455l.773-1.548a1 1 0 011.06-.539l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
              Call (206) 495-0997
            </a>
            <LeadForm client:load pathname={Astro.url.pathname} />
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip: claims already on the site -->
    <section class="bg-brand-dark border-y border-white/10" aria-label="Why homeowners call">
      <div class="container mx-auto px-4 py-4">
        <ul class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-center gap-x-10 gap-y-3 text-white text-xs font-black uppercase tracking-widest">
          <li class="flex items-center gap-2">
            <span class="text-brand-secondary" aria-hidden="true">✓</span>
            Licensed & Insured
          </li>
          <li class="flex items-center gap-2">
            <span class="text-brand-secondary" aria-hidden="true">✓</span>
            10-Year Warranty
          </li>
          <li class="flex items-center gap-2">
            <span class="text-brand-secondary" aria-hidden="true">✓</span>
            Mon-Fri: 7am - 6pm · Sat: 8am - 2pm
          </li>
        </ul>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-slate-50 border-b border-slate-100">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
          {[
            { title: "Licensed & Bonded", desc: "Fully compliant with WA L&I.", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
            { title: "Local Seattle Crew", desc: "Expert PNW soil & rain knowledge.", icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" },
            { title: "10-Year Warranty", desc: "Structural integrity guaranteed.", icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
            { title: "Free Site Audits", desc: "Drainage checks for every project.", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" }
          ].map((item) => (
            <div class="flex items-center gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
              <div class="w-10 h-10 bg-brand-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <h4 class="text-sm font-black text-brand-dark uppercase tracking-tight">{item.title}</h4>
                <p class="text-slate-500 text-[10px] font-medium uppercase tracking-wider leading-tight">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compressed Services Grid -->
    <section id="services" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mb-12">
          <h2 class="text-4xl font-black text-brand-dark mb-4 tracking-tight uppercase">Expert Concrete Services</h2>
          <div class="w-24 h-1.5 bg-brand-primary mb-4"></div>
          <p class="text-lg text-slate-600 font-medium leading-relaxed">Top-tier craftsmanship across Seattle. Efficient, durable, and beautiful.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {SERVICES.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="group p-5 bg-slate-50 border border-slate-100 rounded-2xl hover:bg-white hover:shadow-xl hover:border-brand-primary/20 transition-all duration-300 flex flex-col"
            >
              <div class="flex items-center gap-3 mb-3">
                <div class="flex-shrink-0 w-6 h-6 bg-brand-primary/10 text-brand-primary rounded-full flex items-center justify-center group-hover:bg-brand-primary group-hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <h3 class="text-base font-black text-brand-dark group-hover:text-brand-primary transition-colors leading-tight tracking-tight uppercase">{s.name}</h3>
              </div>
              <p class="text-slate-500 text-[11px] font-medium leading-relaxed line-clamp-2">{s.shortDescription}</p>
              <div class="mt-4 flex items-center gap-1.5 text-brand-primary font-black uppercase tracking-widest text-[9px] opacity-60 group-hover:opacity-100 transition-all">
                View Detail <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Service Areas Hub Section -->
    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-black text-brand-dark mb-6 leading-tight uppercase">Seattle's Local Team</h2>
            <div class="w-20 h-1.5 bg-brand-primary mb-8"></div>
            <p class="text-lg text-slate-600 font-medium leading-relaxed mb-8">
              Deep roots in Seattle. Whether you're in Ballard or West Seattle, we provide reliable local expertise and full permit coordination.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-y-3 gap-x-6 mb-10">
              {NEIGHBORHOODS.slice(0, 12).map(n => (
                <a href={`/locations/${n.slug}`} class="text-slate-600 text-[10px] font-black uppercase tracking-widest hover:text-brand-primary flex items-center gap-2 transition-colors">
                  <span class="w-1.5 h-1.5 bg-brand-primary/30 rounded-full"></span>
                  {n.name}
                </a>
              ))}
            </div>
            <a href="/locations" class="bg-brand-dark text-white px-8 py-4 rounded-xl font-black text-[10px] uppercase tracking-[0.2em] shadow-xl hover:bg-brand-primary transition-all inline-block">
              All Service Areas &rarr;
            </a>
          </div>
          <div class="lg:w-1/2 w-full h-[400px] bg-slate-200 rounded-[2rem] overflow-hidden shadow-2xl relative border border-white">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2689.5!2d-122.339798!3d47.608715!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x21a17cdbeada0b81%3A0x37d1e31ba319afeb!2sCloud%20Concrete%20of%20Seattle!5e0!3m2!1sen!2sus"
              width="100%"
              height="100%"
              style="border: 0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Cloud Concrete Service Map"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Gallery Integration -->
    <Gallery client:visible />

    <!-- Testimonials Integration -->
    <Testimonials />

    <!-- FAQ Section -->
    <section class="py-20 bg-white border-t border-slate-100">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-4xl mx-auto mb-16">
          <h2 class="text-4xl font-black text-brand-dark mb-4 uppercase tracking-tight">Project Guidance</h2>
          <div class="w-20 h-1.5 bg-brand-primary mx-auto"></div>
        </div>
        <div class="max-w-3xl mx-auto space-y-4">
          {FAQS.map((faq) => (
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 shadow-sm group hover:bg-white hover:shadow-lg transition-all">
              <h4 class="text-base font-black text-brand-dark mb-3 group-hover:text-brand-primary transition-colors uppercase tracking-tight">{faq.question}</h4>
              <p class="text-slate-600 text-[11px] font-medium leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 bg-brand-primary text-white overflow-hidden relative">
      <div class="absolute inset-0 bg-brand-dark opacity-10 pointer-events-none"></div>
      <div class="container mx-auto px-4 text-center relative z-10">
        <h2 class="text-5xl md:text-7xl font-black mb-8 leading-tight">Ready to Pour?<br/><span class="text-brand-secondary italic">Let's Talk.</span></h2>
        <p class="text-lg text-white/80 font-medium max-w-xl mx-auto mb-10">Get a free on-site estimate for your driveway, patio, or foundation project. No pressure, just honest pricing from Seattle's concrete pros.</p>
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/contact" class="bg-white text-brand-primary px-10 py-5 rounded-xl font-black text-sm uppercase tracking-widest shadow-2xl hover:scale-105 transition-all">
            Get My Free Quote
          </a>
          <a href={`tel:${PHONE_NUMBER}`} class="bg-brand-dark text-white px-10 py-5 rounded-xl font-black text-sm uppercase tracking-widest shadow-2xl flex items-center gap-4 hover:scale-105 transition-all border border-white/10">
            <svg class="w-6 h-6 text-brand-secondary" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 005.455 5.455l.773-1.548a1 1 0 011.06-.539l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            {PHONE_NUMBER}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
